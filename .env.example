# Optional locally (defaults to sqlite:///local.db).
# REQUIRED on Vercel for durable persistence across serverless invocations:
# provide a pooled PostgreSQL connection string from Neon, Supabase, or Vercel Postgres.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret key used to sign session cookies (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-a-random-32-byte-hex-string

# Set to 0 to disable seeding the demo accounts (alice/bob/carol@example.com)
SEED_DEMO_USERS=1

# Neon Bucket / S3 Object Storage credentials
AWS_ENDPOINT_URL_S3=https://your-neon-or-s3-endpoint.com
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=files-editor

# Secret for Vercel Cron authentication (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=
